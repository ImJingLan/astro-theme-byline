---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalNav from '../../components/LocalNav.astro';
import Tile from '../../components/Tile.astro';
import { categories } from '../../lib/site';

export const getStaticPaths = (async () =>
  categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

const { category } = Astro.props;

const articles = (
  await getCollection(
    'articles',
    ({ data }) => !data.draft && data.category === category.slug
  )
).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title={category.label} description={category.description}>
  <LocalNav title="Newsroom" active="/" />

  <section class="shell pt-14 pb-10 sm:pt-20">
    <p class="eyebrow">Category</p>
    <h1
      class="mt-3 max-w-[820px] font-display text-[40px] leading-[1.08] font-bold tracking-[-0.015em] text-ink sm:text-[56px] sm:leading-[1.05]"
    >
      {category.label}
    </h1>
    <p class="mt-5 max-w-[620px] text-[19px] leading-[1.42] tracking-[-0.012em] text-graphite">
      {category.description}
    </p>
  </section>

  <section class="bg-fog py-14">
    <div class="shell">
      {
        articles.length ? (
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => (
              <li>
                <Tile article={article} variant="3up" />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-[17px] text-graphite">Nothing published in this category yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
