---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalNav from '../../components/LocalNav.astro';
import { site } from '../../lib/site';
import { sortPosts, groupByMonth, postHref } from '../../lib/posts';
import { formatDate, formatMonth } from '../../lib/format';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const groups = groupByMonth(posts);

/** 先把数据整理成「年份 → 月份 → 文章」的扁平结构，模板里只做一层循环 */
const byYear = new Map<number, { label: string; posts: typeof posts }[]>();
for (const group of groups) {
  const year = group.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push({ label: formatMonth(group.date), posts: group.posts });
}

const years = [...byYear.keys()].sort((a, b) => b - a);

const shortDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(date);
---

<BaseLayout title="归档" description={`${site.title} 的全部文章，按时间排列。`}>
  <LocalNav title={site.name} active="/archive/" />

  <section class="shell pt-14 pb-10 sm:pt-20">
    <p class="eyebrow">Archive</p>
    <h1
      class="mt-3 font-display text-[36px] leading-[1.25] font-bold tracking-[0.01em] text-ink sm:text-[52px] sm:leading-[1.2]"
    >
      全部归档
    </h1>
    <p class="mt-5 text-[18px] leading-[1.7] text-graphite">
      {posts.length} 篇文章，从 {years.length ? years[years.length - 1] : '—'} 至今。
    </p>

    <nav class="mt-8 flex flex-wrap gap-2" aria-label="按年份跳转">
      {
        years.map((year) => (
          <a
            href={`#y${year}`}
            class="rounded-full bg-fog px-4 py-1.5 text-[14px] text-graphite transition-colors hover:bg-chip hover:text-ink"
          >
            {year}
          </a>
        ))
      }
    </nav>
  </section>

  <section class="shell pb-24">
    {
      years.map((year) => (
        <div id={`y${year}`} class="scroll-mt-24">
          <h2 class="mt-14 mb-6 font-display text-[28px] leading-[1.3] font-bold text-ink">{year}</h2>

          {(byYear.get(year) ?? []).map((month) => (
            <div class="mb-8">
              <h3 class="mb-3 text-[14px] font-semibold tracking-[0.02em] text-graphite">{month.label}</h3>
              <ul class="flex flex-col">
                {month.posts.map((post) => (
                  <li>
                    <a
                      href={postHref(post)}
                      class="group flex items-baseline gap-4 border-t border-hairline py-3.5 first:border-t-0"
                    >
                      <time
                        class="w-[52px] flex-none text-[13px] tabular-nums text-slate"
                        datetime={post.data.date.toISOString()}
                      >
                        {shortDate(post.data.date)}
                      </time>
                      <span class="min-w-0 flex-1 text-[16px] leading-[1.6] text-ink transition-colors group-hover:text-link">
                        {post.data.title}
                      </span>
                      <span class="hidden flex-none text-[13px] text-slate sm:block">
                        {post.data.categories[0] ?? ''}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))
    }
  </section>
</BaseLayout>
