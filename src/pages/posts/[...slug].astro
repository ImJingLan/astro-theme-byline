---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalNav from '../../components/LocalNav.astro';
import Tile from '../../components/Tile.astro';
import CoverArt from '../../components/CoverArt.astro';
import { site, categoryHref, tagHref } from '../../lib/site';
import { formatDate, readingTime } from '../../lib/format';
import { postHref } from '../../lib/posts';
import { rewriteMarkdownImages } from '../../lib/assets';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

/*
  正文 HTML 由 Astro 的渲染器输出，其 <img> 已被转成 __ASTRO_IMAGE_ 占位符，
  因此图片路径必须在 Markdown 源码阶段就替换好，这里用 rewriteMarkdownImages
  生成一份新的 body 再渲染一次。
*/
const rewrittenBody = rewriteMarkdownImages(post.body ?? '', post.id);
const { Content: ContentWithImages } = await render({
  ...post,
  body: rewrittenBody,
} as typeof post);
const minutes = readingTime(post.body ?? '');

const related = (
  await getCollection(
    'posts',
    ({ data: d, id }) =>
      !d.draft &&
      id !== post.id &&
      d.categories.some((c) => data.categories.includes(c))
  )
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const primaryCategory = data.categories[0];
---

<BaseLayout title={data.title} description={data.summary || site.description}>
  <LocalNav title={site.name} active="/" />

  <article>
    <!-- 文章头 -->
    <header class="shell pt-12 pb-10 sm:pt-16">
      <nav class="mb-6 flex flex-wrap items-center gap-2 text-[13px] text-slate" aria-label="面包屑">
        <a href="/" class="transition-colors hover:text-link">首页</a>
        {
          primaryCategory ? (
            <>
              <span aria-hidden="true">/</span>
              <a href={categoryHref(primaryCategory)} class="transition-colors hover:text-link">
                {primaryCategory}
              </a>
            </>
          ) : null
        }
      </nav>

      <p class="text-[13px] font-semibold tracking-[0.02em] text-graphite">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        <span class="mx-2 text-slate" aria-hidden="true">·</span>
        <span>{minutes} 分钟阅读</span>
      </p>

      <h1
        class="mt-4 max-w-[820px] font-display text-[30px] leading-[1.3] font-bold tracking-[0.01em] text-ink sm:text-[42px] sm:leading-[1.25]"
      >
        {data.title}
      </h1>

      {data.summary ? (
        <p class="mt-5 max-w-[680px] text-[17px] leading-[1.75] text-graphite">{data.summary}</p>
      ) : null}

      {
        data.tags.length ? (
          <div class="mt-6 flex flex-wrap gap-2">
            {data.tags.map((tag) => (
              <a
                href={tagHref(tag)}
                class="rounded-full bg-fog px-3 py-1 text-[13px] text-graphite transition-colors hover:bg-chip hover:text-ink"
              >
                #{tag}
              </a>
            ))}
          </div>
        ) : null
      }
    </header>

    <!-- 头图 -->
    <div class="shell">
      <figure class="overflow-hidden rounded-[20px] sm:rounded-[28px]">
        {
          data.cover ? (
            <img
              src={data.cover}
              alt={data.coverAlt ?? data.title}
              class="w-full object-cover"
              loading="eager"
            />
          ) : (
            <CoverArt
              seed={post.id}
              tone={primaryCategory}
              scale="hero"
              glyph={data.title}
              alt=""
              class="w-full"
            />
          )
        }
      </figure>
    </div>

    <!-- 正文 -->
    <div class="shell py-12 sm:py-16">
      <div class="mx-auto max-w-[700px]">
        <div class="prose-newsroom"><ContentWithImages /></div>

        <!-- 页脚信息 -->
        <footer class="mt-16 border-t border-hairline pt-8">
          <p class="text-[13px] leading-[1.7] text-slate">
            本文由 <span class="text-ink">{data.author ?? site.author}</span> 写于
            {formatDate(data.date)}，最后更新于 {formatDate(data.updated ?? data.date)}。
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="text-[13px] text-graphite">分享：</span>
            <a
              class="cta-pill !px-4 !py-2 !text-[13px]"
              href={`mailto:?subject=${encodeURIComponent(data.title)}&body=${encodeURIComponent(postHref(post))}`}
            >
              邮件
            </a>
            <button
              type="button"
              class="cta-pill !px-4 !py-2 !text-[13px]"
              data-copy-link
              data-url={postHref(post)}
            >
              复制链接
            </button>
            <a class="cta-pill !px-4 !py-2 !text-[13px]" href="/rss.xml">RSS</a>
          </div>
        </footer>
      </div>
    </div>
  </article>

  <!-- 相关文章 -->
  {
    related.length ? (
      <section class="bg-fog py-16">
        <div class="shell">
          <h2 class="section-head mb-6">相关文章</h2>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <li>
                <Tile post={item} variant="3up" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }

  <!-- 上下篇 -->
  <section class="shell py-14">
    <div class="flex items-center justify-between gap-4">
      <a href="/archive/" class="cta-pill">返回归档</a>
      <a href="/" class="cta-link">回到首页 →</a>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = new URL(button.dataset.url ?? '', location.origin).toString();
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(url);
        button.textContent = '已复制';
      } catch {
        button.textContent = '复制失败';
      }
      setTimeout(() => {
        button.textContent = original;
      }, 1600);
    });
  });
</script>
