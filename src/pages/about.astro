---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalNav from '../components/LocalNav.astro';
import { site } from '../lib/site';

// pages/about/index.md → 优先使用这条
const pages = await getCollection('pages', ({ data }) => !data.draft);
const about = pages.find((page) => page.id.includes('about'));

let PageContent: Awaited<ReturnType<typeof render>>['Content'] | undefined;
if (about) {
  PageContent = (await render(about)).Content;
}

const title = about?.data.title ?? '关于';
---

<BaseLayout title={title} description={`关于 ${site.title}`}>
  <LocalNav title={site.name} active="/about/" />

  <section class="shell pt-14 pb-24 sm:pt-20">
    <p class="eyebrow">About</p>
    <h1
      class="mt-3 font-display text-[36px] leading-[1.25] font-bold tracking-[0.01em] text-ink sm:text-[52px] sm:leading-[1.2]"
    >
      {title}
    </h1>

    {
      about ? (
        <div class="prose-newsroom mt-10 max-w-[700px]">
          <PageContent />
        </div>
      ) : (
        <div class="prose-newsroom mt-10 max-w-[700px]">
          <p>
            还没有关于页面。在 <code>src/content/pages/about/index.md</code> 里写一段自我介绍即可。
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
