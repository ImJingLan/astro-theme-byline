---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalNav from '../components/LocalNav.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <LocalNav title="Newsroom" active="/" />
  <section class="shell flex min-h-[52vh] flex-col justify-center py-20">
    <p class="eyebrow text-link">404</p>
    <h1
      class="mt-3 max-w-[720px] font-display text-[40px] leading-[1.08] font-bold tracking-[-0.015em] text-ink sm:text-[56px] sm:leading-[1.05]"
    >
      We could not find that page.
    </h1>
    <p class="mt-5 max-w-[560px] text-[19px] leading-[1.42] tracking-[-0.012em] text-graphite">
      The link may be out of date, or the article may have been moved to the archive.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="cta-pill">Back to Newsroom</a>
      <a href="/news/" class="cta-pill">Browse the archive</a>
    </div>
  </section>
</BaseLayout>
