---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalNav from '../../components/LocalNav.astro';
import Tile from '../../components/Tile.astro';
import { sortPosts } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const names = new Set<string>();
  for (const post of posts) {
    for (const name of post.data.tags) names.add(name);
  }
  return [...names].map((name) => ({ params: { name }, props: { name } }));
}) satisfies GetStaticPaths;

const { name } = Astro.props;
const posts = sortPosts(
  await getCollection('posts', ({ data }) => !data.draft && data.tags.includes(name))
);
---

<BaseLayout title={`标签：${name}`} description={`所有标记为 ${name} 的文章。`}>
  <LocalNav title=" " active="/" />

  <section class="shell pt-14 pb-12 sm:pt-20">
    <nav class="mb-6 flex items-center gap-2 text-[13px] text-slate" aria-label="面包屑">
      <a href="/" class="transition-colors hover:text-link">首页</a>
      <span aria-hidden="true">/</span>
      <a href="/tags/" class="transition-colors hover:text-link">标签</a>
    </nav>

    <p class="eyebrow">Tag</p>
    <h1
      class="mt-3 font-display text-[36px] leading-[1.25] font-bold tracking-[0.01em] text-ink sm:text-[52px] sm:leading-[1.2]"
    >
      #{name}
    </h1>
    <p class="mt-5 text-[18px] leading-[1.7] text-graphite">共 {posts.length} 篇文章。</p>
  </section>

  <section class="bg-fog py-14">
    <div class="shell">
      <ul class="tile-grid">
        {
          posts.map((post, index) => (
            <li class="tile-item">
              <Tile post={post} variant={index === 0 ? 'hero' : '3up'} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
