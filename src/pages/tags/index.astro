---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagHref } from '../../lib/site';
import { getAllPosts, collectTags } from '../../lib/posts';

const posts = await getAllPosts();
const tags = collectTags(posts);
---

<BaseLayout title="Tags" description="Browse every post by tag.">
  <section class="shell pt-14 pb-12 sm:pt-20">
    <p class="eyebrow">Tags</p>
    <h1
      class="mt-3 font-display text-[36px] leading-[1.25] font-bold tracking-[0.01em] text-ink sm:text-[52px] sm:leading-[1.2]"
    >
      Tags
    </h1>
    <p class="mt-5 text-[18px] leading-[1.7] text-graphite">{tags.length}  tags。</p>
  </section>

  <section class="shell pb-24">
    {
      tags.length ? (
        <ul class="flex flex-wrap gap-3">
          {tags.map((tag) => (
            <li>
              <a
                href={tagHref(tag.name)}
                class="inline-flex items-center gap-2 rounded-full bg-fog px-4 py-2 text-[15px] text-ink transition-colors hover:bg-chip"
              >
                #{tag.name}
                <span class="text-[13px] text-slate">{tag.count}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-[17px] text-graphite">No tags yet. Add a tags list to a post’s frontmatter.</p>
      )
    }
  </section>
</BaseLayout>
