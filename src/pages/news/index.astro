---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalNav from '../../components/LocalNav.astro';
import Tile from '../../components/Tile.astro';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// 按年月分组，形成归档时间线
const groups = new Map<string, typeof all>();
for (const article of all) {
  const key = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long' }).format(
    article.data.publishedAt
  );
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(article);
}
---

<BaseLayout title="All News" description="Every announcement, story, and engineering note from Lumen.">
  <LocalNav title="Newsroom" active="/news/" />

  <section class="shell pt-14 pb-10 sm:pt-20">
    <p class="eyebrow">Archive</p>
    <h1
      class="mt-3 max-w-[820px] font-display text-[40px] leading-[1.08] font-bold tracking-[-0.015em] text-ink sm:text-[56px] sm:leading-[1.05]"
    >
      All News
    </h1>
    <p class="mt-5 max-w-[620px] text-[19px] leading-[1.42] tracking-[-0.012em] text-graphite">
      {all.length} articles, newest first.
    </p>
  </section>

  <section class="bg-fog py-14">
    <div class="shell flex flex-col gap-14">
      {
        [...groups.entries()].map(([month, items]) => (
          <div>
            <h2 class="section-head mb-5 text-[24px] leading-[1.1667] tracking-[0.009em]">{month}</h2>
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((article) => (
                <li>
                  <Tile article={article} variant="3up" />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
