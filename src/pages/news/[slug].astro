---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalNav from '../../components/LocalNav.astro';
import CoverArt from '../../components/CoverArt.astro';
import Tile from '../../components/Tile.astro';
import { categoryLabel, site } from '../../lib/site';
import { formatDate, readingTime } from '../../lib/format';

export const getStaticPaths = (async () => {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const minutes = readingTime(article.body ?? data.description);

const related = (
  await getCollection('articles', ({ data: d, id }) => !d.draft && id !== article.id)
)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<BaseLayout title={data.title} description={data.description}>
  <LocalNav title="Newsroom" active="/" />

  <article>
    <!-- 文章头：眉标 + 大标题 + 摘要，单列窄栏 -->
    <header class="shell pt-14 pb-10 sm:pt-18">
      <nav class="mb-6 flex items-center gap-2 text-[12px] tracking-[-0.01em] text-slate">
        <a href="/" class="transition-colors hover:text-link">Newsroom</a>
        <span aria-hidden="true">/</span>
        <a href={`/category/${data.category}/`} class="transition-colors hover:text-link">
          {categoryLabel(data.category)}
        </a>
      </nav>

      <p class="text-[12px] font-bold uppercase tracking-[0.01em] text-graphite">
        {data.eyebrow} &nbsp;{formatDate(data.publishedAt)}
      </p>

      <h1
        class="mt-4 max-w-[820px] font-display text-[36px] leading-[1.0834] font-bold tracking-[-0.008em] text-ink sm:text-[48px] sm:leading-[1.0834]"
      >
        {data.title}
      </h1>

      <p class="mt-5 max-w-[680px] text-[21px] leading-[1.381] font-normal tracking-[0.011em] text-graphite">
        {data.description}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-hairline pt-5">
        <span class="text-[14px] tracking-[-0.016em] text-ink">{data.author}</span>
        <span class="text-[14px] tracking-[-0.016em] text-slate">{minutes} min read</span>
        <span class="text-[14px] tracking-[-0.016em] text-slate">
          {formatDate(data.updatedAt ?? data.publishedAt)}
        </span>
      </div>
    </header>

    <!-- 头图：980px 宽，32px 圆角 -->
    <div class="shell">
      <figure class="overflow-hidden rounded-[24px] sm:rounded-[32px]">
        {
          data.cover ? (
            <img
              src={data.cover.src}
              width={data.cover.width}
              height={data.cover.height}
              alt={data.coverAlt ?? ''}
              class="w-full object-cover"
            />
          ) : (
            <CoverArt
              seed={article.id}
              tone={data.category as any}
              scale="hero"
              glyph={data.title.charAt(0)}
              alt={data.coverAlt || 'Article cover artwork'}
              class="w-full"
            />
          )
        }
      </figure>
    </div>

    <!-- 正文：680px 单栏 -->
    <div class="shell py-14 sm:py-18">
      <div class="mx-auto max-w-[680px]">
        <div class="prose-newsroom">
          <Content />
        </div>

        <!-- 分享行 -->
        <div class="mt-14 flex flex-wrap items-center gap-3 border-t border-hairline pt-6">
          <span class="text-[14px] tracking-[-0.016em] text-graphite">Share this article</span>
          <div class="ml-auto flex items-center gap-2">
            <a
              href={`https://mastodon.social/share?text=${encodeURIComponent(data.title)}`}
              class="cta-pill !px-4 !py-2 !text-[14px]"
              rel="noopener noreferrer"
              target="_blank"
            >
              Mastodon
            </a>
            <a
              href={`mailto:?subject=${encodeURIComponent(data.title)}&body=${encodeURIComponent(site.title)}`}
              class="cta-pill !px-4 !py-2 !text-[14px]"
            >
              Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- 相关文章 -->
  <section class="bg-fog py-16">
    <div class="shell">
      <h2 class="section-head mb-6">More from Newsroom</h2>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          related.map((item) => (
            <li>
              <Tile article={item} variant="3up" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
