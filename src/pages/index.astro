---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalNav from '../components/LocalNav.astro';
import Tile from '../components/Tile.astro';
import Gallery from '../components/Gallery.astro';
import { site } from '../lib/site';
import { formatDate, formatRelative } from '../lib/format';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const [lead, ...rest] = all;
const secondary = rest.slice(0, 4);
const gallery = rest.slice(0, 6);
const more = all.slice(0, 6);
---

<BaseLayout description={site.description}>
  <LocalNav title="Newsroom" active="/" />

  <!-- 页面标题区 -->
  <section class="shell pt-14 pb-10 sm:pt-20">
    <p class="eyebrow">Newsroom</p>
    <h1
      class="mt-3 max-w-[820px] font-display text-[40px] leading-[1.08] font-bold tracking-[-0.015em] text-ink sm:text-[56px] sm:leading-[1.05]"
    >
      The latest from Lumen.
    </h1>
    <p class="mt-5 max-w-[620px] text-[19px] leading-[1.42] tracking-[-0.012em] text-graphite">
      Product announcements, engineering notes, and stories from the people building a calmer way
      to work.
    </p>
  </section>

  <!-- Latest News：整块冷灰背景 + 磁贴网格 -->
  <section class="bg-fog pt-13 pb-20">
    <div class="shell">
      <div class="mb-6 flex items-end justify-between gap-6">
        <h2 class="section-head">Latest News</h2>
        <a href="/news/" class="cta-pill hidden sm:inline-flex">View All</a>
      </div>

      {
        lead ? (
          <ul class="tile-grid">
            <li class="tile-item">
              <Tile article={lead} variant="hero" />
            </li>
            {secondary.map((article, index) => (
              <li class="tile-item">
                <Tile article={article} variant={index < 2 ? '2up' : '3up'} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-[17px] text-graphite">No articles yet. Add a Markdown file to src/content/articles.</p>
        )
      }
    </div>
  </section>

  <!-- In the Loop：横向画廊，箭头与圆点由 site.ts 的 gallery 配置控制 -->
  <section class="bg-fog pb-20">
    <div class="shell">
      <Gallery items={gallery} title="In the Loop" viewAllHref="/news/" />
    </div>
  </section>

  <!-- More from Newsroom -->
  <section class="bg-canvas py-20">
    <div class="shell grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div>
        <h2 class="section-head mb-8">More from Newsroom</h2>
        <div class="flex flex-col">
          {
            more.map((article) => (
              <a
                href={`/news/${article.id}/`}
                class="group grid grid-cols-[1fr_auto] items-start gap-6 border-t border-hairline py-5 first:border-t-0 first:pt-0"
              >
                <div class="min-w-0">
                  <p class="eyebrow">{article.data.eyebrow}</p>
                  <h3 class="tile-headline mt-1.5 text-[19px] leading-[1.2106] tracking-[0.012em] transition-colors group-hover:text-link">
                    {article.data.title}
                  </h3>
                  <p class="mt-2 text-[14px] leading-[1.4286] tracking-[-0.016em] text-graphite">
                    {article.data.description}
                  </p>
                </div>
                <span
                  aria-hidden="true"
                  class="mt-1 grid size-8 flex-none place-items-center rounded-full bg-chip text-ink transition-colors group-hover:bg-chip-hover"
                >
                  <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <aside class="flex flex-col gap-8 lg:pt-2">
        <div class="rounded-[24px] bg-fog p-6">
          <p class="eyebrow">Subscribe</p>
          <h3 class="tile-headline mt-2 text-[21px] leading-[1.1905] tracking-[0.011em]">
            Get the newsroom in your reader.
          </h3>
          <p class="mt-2 text-[14px] leading-[1.4286] tracking-[-0.016em] text-graphite">
            An RSS feed with full articles, no tracking, no account required.
          </p>
          <a href="/rss.xml" class="cta-pill mt-4">RSS Feed</a>
        </div>

        <div class="rounded-[24px] border border-hairline p-6">
          <p class="eyebrow">Latest date</p>
          <p class="mt-2 text-[19px] leading-[1.2106] tracking-[0.012em] font-semibold text-ink">
            {lead ? formatDate(lead.data.publishedAt) : '—'}
          </p>
          <p class="mt-1 text-[14px] leading-[1.4286] tracking-[-0.016em] text-graphite">
            {all.length} articles published
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
