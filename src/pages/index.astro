---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalNav from '../components/LocalNav.astro';
import Tile from '../components/Tile.astro';
import Gallery from '../components/Gallery.astro';
import MoreFromNewsroom from '../components/MoreFromNewsroom.astro';
import { site } from '../lib/site';
import { formatDate, formatRelative } from '../lib/format';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const [lead, ...rest] = all;
const secondary = rest.slice(0, 4);
const gallery = rest.slice(0, 6);
// 列表式区块：跳过头条，取其余文章
const more = all.slice(1, 9);
---

<BaseLayout description={site.description}>
  <LocalNav title="Newsroom" active="/" />

  <!-- 页面标题区 -->
  <section class="shell pt-14 pb-10 sm:pt-20">
    <p class="eyebrow">Newsroom</p>
    <h1
      class="mt-3 max-w-[820px] font-display text-[40px] leading-[1.08] font-bold tracking-[-0.015em] text-ink sm:text-[56px] sm:leading-[1.05]"
    >
      The latest from Lumen.
    </h1>
    <p class="mt-5 max-w-[620px] text-[19px] leading-[1.42] tracking-[-0.012em] text-graphite">
      Product announcements, engineering notes, and stories from the people building a calmer way
      to work.
    </p>
  </section>

  <!-- Latest News：整块冷灰背景 + 磁贴网格 -->
  <section class="bg-fog pt-13 pb-20">
    <div class="shell">
      <div class="mb-6 flex items-end justify-between gap-6">
        <h2 class="section-head">Latest News</h2>
        <a href="/news/" class="cta-pill hidden sm:inline-flex">View All</a>
      </div>

      {
        lead ? (
          <ul class="tile-grid">
            <li class="tile-item">
              <Tile article={lead} variant="hero" />
            </li>
            {secondary.map((article, index) => (
              <li class="tile-item">
                <Tile article={article} variant={index < 2 ? '2up' : '3up'} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-[17px] text-graphite">No articles yet. Add a Markdown file to src/content/articles.</p>
        )
      }
    </div>
  </section>

  <!-- In the Loop：横向画廊，箭头与圆点由 site.ts 的 gallery 配置控制 -->
  <section class="bg-fog pb-20">
    <div class="shell">
      <Gallery items={gallery} title="In the Loop" viewAllHref="/news/" />
    </div>
  </section>

  <!-- More from Newsroom：双列列表式，方形缩略图 + 分隔线 -->
  <MoreFromNewsroom
    items={more}
    title="More from Newsroom"
    archiveHref="/news/"
    archiveLabel="Read the archive"
  />
</BaseLayout>
