---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalNav from '../components/LocalNav.astro';
import Tile from '../components/Tile.astro';
import Gallery from '../components/Gallery.astro';
import MoreFromNewsroom from '../components/MoreFromNewsroom.astro';
import HomeStats from '../components/HomeStats.astro';
import { site, gallery as galleryConfig, categoryHref } from '../lib/site';
import { getAllPosts, collectCategories, collectTags } from '../lib/posts';
import { formatCardDate } from '../lib/format';
import { countWords, formatWordCount, formatUptime } from '../lib/stats';

const posts = await getAllPosts();
const categories = collectCategories(posts);
const tags = collectTags(posts);

const [lead, ...rest] = posts;
const secondary = rest.slice(0, 4);
const galleryPosts = posts.slice(1, 1 + galleryConfig.count);
const more = posts.slice(5, 13);

// 首页统计
const totalWords = posts.reduce((sum, post) => sum + countWords(post.body ?? ''), 0);
const latest = posts.length ? formatCardDate(posts[0].data.date) : '—';
---

<BaseLayout description={site.description}>
  <LocalNav title={site.name} active="/" />

  <!-- 页面标题区：文字在左，统计表在右 -->
  <section class="shell pt-14 pb-10 sm:pt-20">
    <div class="flex flex-col gap-10 xl:flex-row xl:items-end xl:justify-between xl:gap-12">
      <div class="min-w-0">
        <p class="eyebrow">{site.intro.eyebrow}</p>
        <h1
          class="mt-3 max-w-[820px] font-display text-[36px] leading-[1.25] font-bold tracking-[0.01em] text-ink sm:text-[52px] sm:leading-[1.2]"
        >
          {site.intro.heading}
        </h1>
        <p class="mt-5 max-w-[620px] text-[18px] leading-[1.7] tracking-[0.01em] text-graphite">
          {site.intro.lead}
        </p>
      </div>

      <HomeStats
        postCount={posts.length}
        tagCount={tags.length}
        wordsLabel={formatWordCount(totalWords)}
        latest={latest}
        uptime={formatUptime()}
      />
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="bg-fog pt-13 pb-20">
    <div class="shell">
      <div class="mb-6 flex items-end justify-between gap-6">
        <h2 class="section-head">最新文章</h2>
        <a href="/archive/" class="cta-pill hidden sm:inline-flex">全部归档</a>
      </div>

      {
        lead ? (
          <ul class="tile-grid">
            <li class="tile-item">
              <Tile post={lead} variant="hero" />
            </li>
            {secondary.map((post, index) => (
              <li class="tile-item">
                <Tile post={post} variant={index < 2 ? '2up' : '3up'} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-[17px] text-graphite">
            还没有文章。把 Markdown 放进 src/content/posts 就会出现在这里。
          </p>
        )
      }
    </div>
  </section>

  <!-- 画廊 -->
  {
    galleryPosts.length >= 2 ? (
      <section class="bg-fog pb-20">
        <div class="shell">
          <Gallery posts={galleryPosts} viewAllHref="/archive/" />
        </div>
      </section>
    ) : null
  }

  <!-- 更多文章 -->
  {
    more.length ? (
      <MoreFromNewsroom posts={more} title="更多文章" archiveHref="/archive/" archiveLabel="查看全部归档" />
    ) : null
  }

  <!-- 分类 -->
  {
    categories.length ? (
      <section class="py-16 sm:py-20">
        <div class="shell">
          <h2 class="section-head mb-6">按分类浏览</h2>
          <ul class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <li>
                <a
                  href={categoryHref(category.name)}
                  class="inline-flex items-center gap-2 rounded-full bg-chip px-5 py-2.5 text-[15px] font-medium text-ink transition-colors hover:bg-chip-hover"
                >
                  {category.name}
                  <span class="text-[13px] text-slate">{category.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }
</BaseLayout>
