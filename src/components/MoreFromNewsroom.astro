---
/**
 * MoreFromNewsroom —— 列表式「更多文章」区块。
 *
 * 方形缩略图 + 右侧文字、桌面双列、每条下方分隔线、底部居中按钮。
 * 配图优先使用文章自带 cover，否则用 CoverArt 程序化生成。
 */
import CoverArt from './CoverArt.astro';
import { formatDate } from '../lib/format';
import { postHref, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  title?: string;
  archiveHref?: string;
  archiveLabel?: string;
}

const {
  posts,
  title = '更多文章',
  archiveHref = '/archive/',
  archiveLabel = '查看全部归档',
} = Astro.props;
---

<section class="bg-fog py-10 sm:py-16 lg:py-20">
  <div class="shell">
    {
      title ? (
        <div class="mb-6 sm:mb-11 lg:mb-16">
          <h2 class="section-head !mb-0 text-[24px] sm:text-[28px] lg:text-[32px]">{title}</h2>
        </div>
      ) : null
    }

    <ul role="list" class="mfr-list">
      {
        posts.map((post) => (
          <li class="mfr-item">
            <a href={postHref(post)} class="mfr-tile group">
              <div class="mfr-media">
                {post.data.cover ? (
                  <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                ) : (
                  <CoverArt
                    seed={post.id}
                    tone={post.data.categories[0]}
                    scale="square"
                    glyph={post.data.title}
                    alt=""
                  />
                )}
              </div>

              <div class="mfr-desc">
                <div>
                  <p class="eyebrow mfr-category">{post.data.categories[0] ?? '文章'}</p>
                  <h3 class="mfr-headline">{post.data.title}</h3>
                </div>
                <p class="mfr-timestamp">{formatDate(post.data.date)}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    {
      archiveHref ? (
        <div class="mt-9 flex justify-center sm:mt-16">
          <a href={archiveHref} class="cta-pill">
            {archiveLabel}
          </a>
        </div>
      ) : null
    }
  </div>
</section>

<style>
  /*
    桌面端双列：列表右移出容器 56px（980 → 1036），每条自带 56px 右外边距，
    列宽约 462px，左列分隔线向右延伸一个列间距与右列连成一条横线。
    平板及以下退化为单列，取消负外边距避免溢出。
  */
  .mfr-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1069px) {
    .mfr-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-right: -56px;
    }
  }

  .mfr-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 28px;
    min-width: 0;
  }

  @media (min-width: 735px) {
    .mfr-item {
      margin-bottom: 32px;
    }
  }

  @media (min-width: 1069px) {
    .mfr-item {
      margin-bottom: 44px;
      margin-right: 56px;
    }
  }

  .mfr-item::after {
    content: '';
    display: block;
    flex: 0 0 auto;
    height: 1px;
    margin-top: 28px;
    background-color: var(--color-hairline);
    width: 100%;
  }

  @media (min-width: 735px) {
    .mfr-item::after {
      margin-top: 32px;
    }
  }

  @media (min-width: 1069px) {
    .mfr-item::after {
      margin-top: 44px;
    }

    .mfr-item:nth-child(odd)::after {
      width: calc(100% + 56px);
    }
  }

  .mfr-item:last-child {
    margin-bottom: 0;
  }

  .mfr-item:last-child::after {
    display: none;
  }

  @media (min-width: 1069px) {
    .mfr-item:nth-last-child(2):nth-child(odd) {
      margin-bottom: 0;
    }

    .mfr-item:nth-last-child(2):nth-child(odd)::after {
      display: none;
    }
  }

  .mfr-tile {
    display: flex;
    align-items: center;
    gap: 0;
    text-decoration: none;
    min-width: 0;
  }

  .mfr-media {
    flex: 0 0 auto;
    width: 105px;
    height: 105px;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-chip);
  }

  @media (min-width: 1069px) {
    .mfr-media {
      width: 132px;
      height: 132px;
      border-radius: 20px;
    }
  }

  .mfr-media :global(svg),
  .mfr-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-soft);
  }

  .mfr-tile:hover .mfr-media :global(svg),
  .mfr-tile:hover .mfr-media :global(img) {
    transform: scale(1.04);
  }

  .mfr-desc {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding-left: 16px;
  }

  @media (min-width: 1069px) {
    .mfr-desc {
      padding-left: 28px;
    }
  }

  .mfr-category {
    margin-bottom: 8px;
    font-size: 12px;
  }

  @media (min-width: 1069px) {
    .mfr-category {
      font-size: 14px;
    }
  }

  .mfr-headline {
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.012em;
    color: var(--color-ink);
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 1069px) {
    .mfr-headline {
      font-size: 21px;
      line-height: 1.4;
      letter-spacing: 0.011em;
    }
  }

  .mfr-tile:hover .mfr-headline {
    color: var(--color-link);
  }

  .mfr-timestamp {
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-graphite);
    letter-spacing: 0.01em;
  }

  @media (min-width: 1069px) {
    .mfr-timestamp {
      font-size: 17px;
    }
  }
</style>
