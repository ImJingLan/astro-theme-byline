---
/**
 * MoreFromNewsroom —— 列表式「更多文章」区块。
 *
 * 方形缩略图 + 右侧文字、桌面双列、每条下方分隔线、底部居中按钮。
 * 配图优先使用文章自带 cover，否则用 CoverArt 程序化生成。
 */
import CoverArt from './CoverArt.astro';
import { formatCardDate, formatCardDateISO } from '../lib/format';
import { postHref, type Post } from '../lib/posts';
import { postCover } from '../lib/covers';

interface Props {
  posts: Post[];
  title?: string;
  archiveHref?: string;
  archiveLabel?: string;
}

const {
  posts,
  title = '更多文章',
  archiveHref = '/archive/',
  archiveLabel = '查看全部归档',
} = Astro.props;
---

<section class="bg-fog py-10 sm:py-16 lg:py-20">
  <div class="shell">
    {
      title ? (
        <div class="mb-6 sm:mb-11 lg:mb-16">
          <h2 class="section-head !mb-0 text-[24px] sm:text-[28px] lg:text-[32px]">{title}</h2>
        </div>
      ) : null
    }

    <ul role="list" class="mfr-list">
      {
        posts.map((post) => {
          const cover = postCover(post);
          return (
          <li class="mfr-item">
            <a href={postHref(post)} class="mfr-tile group">
              <div class="mfr-media">
                {cover ? (
                  <img
                    src={cover.src}
                    width={cover.width}
                    height={cover.height}
                    alt={post.data.title}
                    loading="lazy"
                  />
                ) : (
                  <CoverArt
                    seed={post.id}
                    tone={post.data.categories[0]}
                    scale="square"
                    glyph={post.data.title}
                    alt=""
                  />
                )}
              </div>

              <div class="mfr-desc">
                <div>
                  <p class="eyebrow mfr-category">{post.data.categories[0] ?? '文章'}</p>
                  <h3 class="mfr-headline">{post.data.title}</h3>
                </div>
                <time class="mfr-timestamp" datetime={formatCardDateISO(post.data.date)}>
                  {formatCardDate(post.data.date)}
                </time>
              </div>
            </a>
          </li>
          );
        })
      }
    </ul>

    {
      archiveHref ? (
        <div class="mt-9 flex justify-center sm:mt-16">
          <a href={archiveHref} class="cta-pill">
            {archiveLabel}
          </a>
        </div>
      ) : null
    }
  </div>
</section>

<style>
  /*
    桌面端双列：列表右移出容器 56px（980 → 1036），每条自带 56px 右外边距，
    列宽约 462px，左列分隔线向右延伸一个列间距与右列连成一条横线。
    平板及以下退化为单列，取消负外边距避免溢出。
  */
  .mfr-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1069px) {
    .mfr-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-right: -56px;
    }
  }

  /*
    分隔线统一由 ::before 绘制，只有一种粗细（1px），不会出现拼接错位。

    条目用 padding 上下留白：线画在条目顶部，上方间距来自上一条的 padding-bottom，
    下方间距来自本条 padding-top，两边天然相等。

    单列（<1069px）：每项之间一条线，第一项不画。
    双列（≥1069px）：每行之间一条线，第一行不画；左列的线向右延伸 56px
    跨过列间距，与右列的线接成完整的一条。
  */
  .mfr-item {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: 28px 0;
  }

  .mfr-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-hairline);
  }

  /* 单列：第一项不画线 */
  .mfr-item:first-child::before {
    display: none;
  }

  @media (min-width: 735px) {
    .mfr-item {
      padding: 32px 0;
    }
  }

  @media (min-width: 1069px) {
    .mfr-item {
      padding: 44px 0;
      margin-right: 56px;
    }

    /* 双列：第一行两项都不画线 */
    .mfr-item:nth-child(-n + 2)::before {
      display: none;
    }

    /* 左列的线向右跨过列间距 */
    .mfr-item:nth-child(odd)::before {
      right: -56px;
    }
  }

  .mfr-tile {
    display: flex;
    align-items: center;
    gap: 0;
    text-decoration: none;
    min-width: 0;
  }

  .mfr-media {
    flex: 0 0 auto;
    width: 105px;
    height: 105px;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-chip);
  }

  @media (min-width: 1069px) {
    .mfr-media {
      width: 132px;
      height: 132px;
      border-radius: 20px;
    }
  }

  .mfr-media :global(svg),
  .mfr-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-soft);
  }

  .mfr-tile:hover .mfr-media :global(svg),
  .mfr-tile:hover .mfr-media :global(img) {
    transform: scale(1.04);
  }

  .mfr-desc {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding-left: 16px;
  }

  /* 文字块整体撑满缩略图高度，两列的分隔线才会落在同一水平线上 */
  .mfr-tile {
    height: 100%;
  }

  @media (min-width: 1069px) {
    .mfr-desc {
      padding-left: 28px;
    }
  }

  .mfr-category {
    margin-bottom: 8px;
    font-size: 12px;
  }

  @media (min-width: 1069px) {
    .mfr-category {
      font-size: 14px;
    }
  }

  /*
    标题固定最多两行。行数不一致会让同一行的两个条目高度不同，
    进而把 ::after 画出的分隔线推到不同位置。
  */
  .mfr-headline {
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.012em;
    color: var(--color-ink);
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* 无论标题是一行还是两行，都占两行高度，保证条目等高 */
    min-height: calc(2 * 1.4em);
  }

  @media (min-width: 1069px) {
    .mfr-headline {
      font-size: 21px;
      line-height: 1.4;
      letter-spacing: 0.011em;
    }
  }

  .mfr-tile:hover .mfr-headline {
    color: var(--color-link);
  }

  .mfr-timestamp {
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-graphite);
    letter-spacing: 0.01em;
  }

  @media (min-width: 1069px) {
    .mfr-timestamp {
      font-size: 17px;
    }
  }
</style>
