---
/**
 * 主题切换按钮。
 *
 * 三态循环：跟随系统 → 浅色 → 深色 → 跟随系统。
 * 图标用内联 SVG，按当前状态由脚本切换可见性。
 */
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-label="切换主题"
  aria-live="polite"
  title="切换主题"
>
  {/* 跟随系统：半明半暗的圆 */}
  <svg class="theme-icon theme-icon--system" viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M10 2.5a7.5 7.5 0 0 1 0 15z" fill="currentColor"></path>
  </svg>

  {/* 浅色：太阳 */}
  <svg class="theme-icon theme-icon--light" viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="10" cy="10" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2"></path>
      <path d="M4 4l1.4 1.4M14.6 14.6L16 16M16 4l-1.4 1.4M5.4 14.6L4 16"></path>
    </g>
  </svg>

  {/* 深色：月亮 */}
  <svg class="theme-icon theme-icon--dark" viewBox="0 0 20 20" aria-hidden="true">
    <path
      d="M16.5 12.5A7 7 0 0 1 7.5 3.5a7 7 0 1 0 9 9z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  /*
    在 <head> 里内联执行的脚本负责「首屏前」设置属性，避免闪白；
    这里只负责交互。两者共用同一个 localStorage 键。
  */
  type Mode = 'system' | 'light' | 'dark';

  const STORAGE_KEY = 'theme';
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  const prefersDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;

  const resolve = (mode: Mode): 'light' | 'dark' =>
    mode === 'system' ? (prefersDark() ? 'dark' : 'light') : mode;

  const apply = (mode: Mode) => {
    root.dataset.theme = resolve(mode);
    root.dataset.themeMode = mode;
    button?.setAttribute(
      'aria-label',
      mode === 'system' ? '主题：跟随系统' : mode === 'light' ? '主题：浅色' : '主题：深色'
    );
    // 浏览器 UI 配色跟着走
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', resolve(mode) === 'dark' ? '#1c1c1e' : '#ffffff');
  };

  const readMode = (): Mode => {
    const stored = localStorage.getItem(STORAGE_KEY);
    return stored === 'light' || stored === 'dark' ? stored : 'system';
  };

  let mode = readMode();
  apply(mode);

  /*
    swup 换页会把导航栏之外的 DOM 换掉，但导航栏本身留在原处，
    按钮元素不变，所以监听器只需绑一次。这里仍按「重新查询」写，
    避免将来把按钮挪进 <main> 时静默失效。
  */
  const bind = () => {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      // 三态循环
      mode = mode === 'system' ? 'light' : mode === 'light' ? 'dark' : 'system';
      if (mode === 'system') localStorage.removeItem(STORAGE_KEY);
      else localStorage.setItem(STORAGE_KEY, mode);
      apply(mode);
    });
  };

  bind();
  document.addEventListener('astro:page-load', bind);

  // 跟随系统时，系统主题变化要实时反映
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (mode === 'system') apply('system');
    });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
    color: var(--color-graphite);
    background-color: transparent;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-ink);
    background-color: var(--color-chip);
  }

  .theme-icon {
    width: 18px;
    height: 18px;
    display: none;
  }

  /* 按当前模式显示对应图标；由 html[data-theme-mode] 决定 */
  :global(html[data-theme-mode='system']) .theme-icon--system,
  :global(html[data-theme-mode='light']) .theme-icon--light,
  :global(html[data-theme-mode='dark']) .theme-icon--dark {
    display: block;
  }

  /* 脚本尚未执行时，先显示系统图标 */
  :global(html:not([data-theme-mode])) .theme-icon--system {
    display: block;
  }
</style>
