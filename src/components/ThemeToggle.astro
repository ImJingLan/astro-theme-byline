---
import { t } from '../i18n';
/**
 * 主题切换按钮。
 *
 * 只有亮 / 暗两态。首次访问时若没有存过偏好，
 * 用系统当前的主题作为初始值，之后完全由用户的选择决定。
 *
 * 切换时用 View Transitions 做一次圆形遮罩扩散：
 * 新主题以按钮为圆心向外铺开，旧主题被覆盖。
 */
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-label={t.theme.switch}
  aria-live="polite"
  title={t.theme.switch}
>
  {/* 亮色：太阳 */}
  <svg class="theme-icon theme-icon--light" viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="10" cy="10" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2"></path>
      <path d="M4 4l1.4 1.4M14.6 14.6L16 16M16 4l-1.4 1.4M5.4 14.6L4 16"></path>
    </g>
  </svg>

  {/* 暗色：月亮 */}
  <svg class="theme-icon theme-icon--dark" viewBox="0 0 20 20" aria-hidden="true">
    <path
      d="M16.5 12.5A7 7 0 0 1 7.5 3.5a7 7 0 1 0 9 9z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  /*
    <head> 里的内联脚本负责首屏前设置 data-theme，避免闪白；
    这里只负责交互。两者共用同一个 localStorage 键。
  */
  type Theme = 'light' | 'dark';

  const STORAGE_KEY = 'theme';
  const root = document.documentElement;

  const apply = (theme: Theme) => {
    root.dataset.theme = theme;
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme === 'dark' ? '#1c1c1e' : '#ffffff');
    document
      .getElementById('theme-toggle')
      ?.setAttribute('aria-label', theme === 'dark' ? t.theme.toLight : t.theme.toDark);
  };

  const current = (): Theme => (root.dataset.theme === 'dark' ? 'dark' : 'light');

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * 以按钮为圆心把新主题铺开。
   *
   * 半径取到视口最远角，保证圆形能覆盖整屏；
   * 圆心用按钮中心，视觉上像是从开关处扩散出来。
   */
  const circleFrom = (el: HTMLElement) => {
    const rect = el.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    return { x, y, radius };
  };

  const switchTo = (next: Theme, btn: HTMLElement) => {
    // 不支持 View Transitions 或用户要求减少动效时直接切换
    if (!document.startViewTransition || reduceMotion()) {
      localStorage.setItem(STORAGE_KEY, next);
      apply(next);
      return;
    }

    const { x, y, radius } = circleFrom(btn);

    const transition = document.startViewTransition(() => {
      localStorage.setItem(STORAGE_KEY, next);
      apply(next);
    });

    // 等快照就绪再驱动动画，否则会被浏览器的默认淡入淡出顶掉
    transition.ready
      .then(() => {
        root.animate(
          {
            clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`],
          },
          {
            duration: 520,
            easing: 'cubic-bezier(0.28, 0.11, 0.32, 1)',
            pseudoElement: '::view-transition-new(root)',
          }
        );
      })
      .catch(() => {
        // 过渡被中断（例如连续点击）时忽略，状态已经切好了
      });
  };

  /*
    swup 换页会换掉 <main> 里的 DOM，导航栏留在原处、按钮不变，
    所以监听器只需绑一次。仍按「重新查询」写，避免将来挪动按钮时静默失效。
  */
  const bind = () => {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';

    btn.addEventListener('click', () => {
      const next: Theme = current() === 'dark' ? 'light' : 'dark';
      switchTo(next, btn);
    });
  };

  // 首屏脚本已设好 data-theme，这里同步一次按钮文案与浏览器配色
  apply(current());
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  /*
    默认的整页交叉淡入会把遮罩动画盖掉，这里关掉两边的动画，
    只留 ::view-transition-new 的 clip-path 扩散。
  */
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }

  /* 新主题在上层，才能盖住旧主题 */
  :global(::view-transition-new(root)) {
    z-index: 2;
  }

  :global(::view-transition-old(root)) {
    z-index: 1;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
    color: var(--color-graphite);
    background-color: transparent;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-ink);
    background-color: var(--color-chip);
  }

  /* 点击时轻微缩放，给遮罩一个起点上的反馈 */
  .theme-toggle:active {
    scale: 0.92;
  }

  .theme-icon {
    width: 18px;
    height: 18px;
    display: none;
  }

  /* 当前是暗色 → 显示太阳（提示点了会变亮）；亮色 → 显示月亮 */
  :global(html[data-theme='dark']) .theme-icon--light,
  :global(html:not([data-theme='dark'])) .theme-icon--dark {
    display: block;
  }
</style>
