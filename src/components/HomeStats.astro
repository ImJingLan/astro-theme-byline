---
/**
 * 首页统计表。
 *
 * 用 `gap-px` 铺在内线颜色上，让格子之间出现 1px 细线，
 * 不需要给每个格子单独画边框。
 *
 * 布局：
 *   小屏  2×2
 *   中屏  一行四个
 *   大屏  2×2（作为右侧窄栏时）
 */
interface Props {
  postCount: number;
  tagCount: number;
  wordsLabel: string;
  latest: string;
  uptime: string;
  thanks?: string;
}

const { postCount, tagCount, wordsLabel, latest, uptime, thanks = 'Example' } = Astro.props;

const stats = [
  ['文章', String(postCount)],
  ['标签', String(tagCount)],
  ['总字数', wordsLabel],
  ['最近更新', latest],
] as const;
---

<dl class="stats-ledger">
  {
    stats.map(([label, value]) => (
      <div class="stats-cell">
        <dt class="stats-label">{label}</dt>
        <dd class="stats-value">{value}</dd>
      </div>
    ))
  }

  <div class="stats-cell stats-cell--wide">
    <dt class="stats-label">运行时间</dt>
    <dd id="site-uptime" class="stats-value">{uptime}</dd>
  </div>

  <div class="stats-cell stats-cell--wide">
    <dt class="stats-label">特别感谢</dt>
    <dd class="stats-value">{thanks}</dd>
  </div>
</dl>

<script>
  import { formatUptime } from '../lib/stats';

  const el = document.getElementById('site-uptime');
  if (el) {
    const paint = () => {
      el.textContent = formatUptime();
    };

    let timer: number | null = null;
    const start = () => {
      if (timer !== null) clearInterval(timer);
      if (document.hidden) return;
      paint();
      timer = window.setInterval(paint, 1000);
    };
    const stop = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    };

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    window.addEventListener('pagehide', stop);
    start();
  }
</script>

<style>
  .stats-ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* 用 1px 间隙透出底色，形成细线 */
    gap: 1px;
    margin: 0;
    padding: 0;
    background-color: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    border-radius: 16px;
    overflow: hidden;
    max-width: 600px;
    flex-shrink: 0;
    width: 100%;
  }

  /* 宽屏作为右栏时固定宽度，避免被内容挤压 */
  @media (min-width: 1069px) {
    .stats-ledger {
      width: 400px;
      max-width: none;
    }
  }

  @media (min-width: 735px) and (max-width: 1068px) {
    .stats-ledger {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: none;
    }
  }

  .stats-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 10px;
    background-color: var(--color-canvas);
  }

  @media (min-width: 735px) {
    .stats-cell {
      padding: 12px 16px;
    }
  }

  /* 运行时间与特别感谢跨两列 */
  .stats-cell--wide {
    grid-column: span 2;
  }

  @media (min-width: 735px) and (max-width: 1068px) {
    .stats-cell--wide {
      grid-column: span 4;
    }
  }

  .stats-label {
    font-size: 12px;
    line-height: 1.3;
    color: var(--color-slate);
  }

  .stats-value {
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink);
    margin: 0;
  }

  @media (min-width: 735px) {
    .stats-value {
      font-size: 18px;
    }
  }
</style>
