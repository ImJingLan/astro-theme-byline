---
import { t } from '../i18n';
/**
 * 首页统计表。
 *
 * 用 `gap-px` 铺在内线颜色上，让格子之间出现 1px 细线，
 * 不需要给每个格子单独画边框。
 *
 * 布局：
 *   小屏  2×2
 *   中屏  一行四个
 *   大屏  2×2（作为右侧窄栏时）
 */
interface Props {
  postCount: number;
  tagCount: number;
  wordsLabel: string;
  latest: string;
  uptime: string;
  thanks?: string;
}

const { postCount, tagCount, wordsLabel, latest, uptime } = Astro.props;

const stats = [
  [t.common.posts, String(postCount)],
  [t.common.tags, String(tagCount)],
  [t.common.words, wordsLabel],
  [t.common.lastUpdated, latest],
] as const;
---

<dl class="stats-ledger">
  {
    stats.map(([label, value]) => (
      <div class="stats-cell">
        <dt class="stats-label">{label}</dt>
        <dd class="stats-value">{value}</dd>
      </div>
    ))
  }

  <div class="stats-cell stats-cell--wide">
    <dt class="stats-label">{t.common.uptime}</dt>
    <dd id="site-uptime" class="stats-value">{uptime}</dd>
  </div>
</dl>

<script>
  import { formatUptime } from '../lib/stats';

  let timer: number | null = null;

  /*
    每次刷新都重新查一次元素：swup 换页会换掉 <main> 里的 DOM，
    抓住旧引用的话计时器会一直在改一个已经脱离文档的节点。
  */
  const paint = (): boolean => {
    const el = document.getElementById('site-uptime');
    if (!el) return false;
    el.textContent = formatUptime();
    return true;
  };

  const stop = () => {
    if (timer !== null) {
      clearInterval(timer);
      timer = null;
    }
  };

  const start = () => {
    stop();
    if (document.hidden) return;
    // 首页之外没有这个元素，直接不启动
    if (!paint()) return;
    timer = window.setInterval(() => {
      if (!paint()) stop();
    }, 1000);
  };

  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  window.addEventListener('pagehide', stop);
  // 首次加载与每次 swup 切换后都重启，避免指向旧节点或留下多个计时器
  document.addEventListener('astro:page-load', start);
  start();
</script>

<style>
  /*
    表格宽度跟随 hero-grid 的列数走，断点与它保持一致（1280px）：
      单列区间（<1280px）  撑满整行
      两列区间（≥1280px）  固定 400px，作为右栏
    手机端（<735px）额外限制 600px，避免 2×2 的格子被拉得过宽。
  */
  .stats-ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* 用 1px 间隙透出底色，形成细线 */
    gap: 1px;
    margin: 0;
    padding: 0;
    background-color: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    border-radius: 16px;
    overflow: hidden;
    width: 100%;
    max-width: 600px;
  }

  /* 平板及以上：单列布局，撑满整行，并排成一行四格 */
  @media (min-width: 735px) {
    .stats-ledger {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: none;
    }
  }

  /* 宽屏：并排右栏，固定 400px，回到 2×2 */
  @media (min-width: 1280px) {
    .stats-ledger {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 400px;
      max-width: none;
    }
  }

  .stats-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 10px;
    background-color: var(--color-canvas);
  }

  @media (min-width: 735px) {
    .stats-cell {
      padding: 12px 16px;
    }
  }

  /* 运行时间与特别感谢跨两列 */
  .stats-cell--wide {
    grid-column: span 2;
  }

  @media (min-width: 735px) and (max-width: 1068px) {
    .stats-cell--wide {
      grid-column: span 4;
    }
  }

  .stats-label {
    font-size: 12px;
    line-height: 1.3;
    color: var(--color-slate);
  }

  .stats-value {
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink);
    margin: 0;
  }

  @media (min-width: 735px) {
    .stats-value {
      font-size: 18px;
    }
  }
</style>
