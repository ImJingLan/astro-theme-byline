---
import { site } from '../lib/site';

const { path = '/' } = Astro.props;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- 顶部全局导航：44px 高、近黑底、12px 链接 -->
<header class="sticky top-0 z-50 bg-night/80 backdrop-blur-xl backdrop-saturate-150">
  <nav class="shell flex h-11 items-center justify-between" aria-label="全局导航">
    <a
      href="/"
      class="flex items-center gap-2 text-[12px] text-white/80 transition-colors hover:text-white"
      aria-label={site.title}
    >
      <span aria-hidden="true" class="grid size-[18px] place-items-center rounded-[5px] bg-white/90">
        <span class="block size-[7px] rounded-[1.5px] bg-night"></span>
      </span>
      <span class="text-[13px] font-semibold text-white">{site.name}</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        site.globalNav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'text-[12px] transition-colors',
                isActive(item.href) ? 'text-white' : 'text-white/80 hover:text-white',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/archive/"
      class="flex size-[18px] items-center justify-center text-white/80 transition-colors hover:text-white md:hidden"
      aria-label="全部文章"
    >
      <svg viewBox="0 0 18 18" class="size-[15px]" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="8" cy="8" r="5.2"></circle>
        <path d="M12 12l4 4" stroke-linecap="round"></path>
      </svg>
    </a>
  </nav>
</header>
