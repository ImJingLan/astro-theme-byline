---
/**
 * 全局导航栏。
 *
 * 浅色、细线、吸顶：左侧站点图标 + 名称，右侧站内导航。
 */
import { t } from '../i18n';
import { site } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** 当前路径，用于高亮 */
  active?: string;
}

const { active = '/' } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? active === '/' : active.startsWith(href);

const logo = site.logo?.trim() ?? '';
---

<header class="sticky top-0 z-50 border-b border-hairline/60 bg-canvas/85 backdrop-blur-xl">
  <div class="shell flex h-[56px] items-center justify-between gap-6">
    <a
      href="/"
      class="flex min-w-0 items-center gap-2.5 text-ink transition-opacity hover:opacity-70"
    >
      {
        logo ? (
          <img
            src={logo}
            alt=""
            width="24"
            height="24"
            class="size-[24px] flex-none rounded-[6px] object-cover"
            loading="eager"
          />
        ) : (
          <span aria-hidden="true" class="grid size-[22px] flex-none place-items-center rounded-[6px] bg-night">
            <span class="block size-[8px] rounded-[2px] bg-canvas" />
          </span>
        )
      }
      <span class="truncate text-[17px] font-semibold tracking-[0.01em]">{site.name}</span>
    </a>

    <div class="flex items-center gap-3 sm:gap-5">
    <nav aria-label={t.nav.site}>
      <ul class="flex items-center gap-5 sm:gap-7">
        {
          site.globalNav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'text-[14px] tracking-[0.01em] transition-colors',
                  isActive(item.href)
                    ? 'font-semibold text-ink'
                    : 'font-normal text-graphite hover:text-ink',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
    </div>
  </div>

  {/* 切换页面时沿导航底边扫过的一条进度条 */}
  <span class="route-bar" aria-hidden="true"></span>
</header>
