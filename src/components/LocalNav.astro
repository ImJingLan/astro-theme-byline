---
import { site } from '../lib/site';

interface Props {
  /** 左侧标题；传空字符串则隐藏（子页面用） */
  title?: string;
  active?: string;
}
const { title = site.name, active = '/' } = Astro.props;
---

<!-- 博客子导航：浅色细线、21px 标题、14px 链接 -->
<div class="border-b border-black/8 bg-canvas/85 backdrop-blur-xl">
  <div class="shell flex h-[52px] items-center justify-between gap-6">
    <a
      href="/"
      class="truncate text-[21px] font-semibold tracking-[0.01em] text-ink transition-opacity hover:opacity-70"
    >
      {title || site.title}
    </a>

    <nav aria-label="站内导航">
      <ul class="flex items-center gap-5 sm:gap-7">
        {
          site.localNav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'text-[14px] tracking-[0.01em] transition-colors',
                  active === item.href
                    ? 'font-semibold text-ink'
                    : 'font-normal text-graphite hover:text-ink',
                ]}
                aria-current={active === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>
